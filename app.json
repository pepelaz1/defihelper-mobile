{
  "expo": {
    "name": "DefiHelper",
    "slug": "defihelper-mobile",
    "version": "1.0.0",
    "scheme": "defihelper",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f5efe1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.pepelaz1.defihelper",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pepelaz1.defihelper",
      "adaptiveIcon": {
        "backgroundColor": "#f5efe1"
      }
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
