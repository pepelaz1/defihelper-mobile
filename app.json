{
  "expo": {
    "name": "DefiHelper",
    "slug": "defihelper-mobile",
    "version": "1.0.0",
    "scheme": "defihelper",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5efe1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.pepelaz1.defihelper",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pepelaz1.defihelper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5efe1"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3042f772-5c00-420e-a16f-07de8b0e2c70"
      }
    },
    "owner": "pepelaz"
  }
}
